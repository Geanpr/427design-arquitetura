# Copie para .env e preencha quando o gateway for definido.
# As chaves secretas NUNCA vão no front-end — apenas no backend/serverless.

# Endpoint do seu backend que cria a preferência/sessão de pagamento
VITE_API_PAGAMENTO=/api/pagamento

